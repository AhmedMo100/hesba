{
  "name": "hesba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma migrate dev --create-only",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "format": "prettier --write .",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "7.10.1",
    "@sentry/nextjs": "11.11.0",
    "@serwist/next": "^9.5.13",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "next": "16.4.5",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "handlebars": ">=4.7.10",
      "fast-uri": ">=3.1.9",
      "zod": ">=4.6.7"
    }
  },
  "packageManager": "pnpm@10.20.0"
}
