# Database & Local Development Ports
# Local Postgres container host port (defaults to 5432 in docker-compose.dev.yml).
# If port 5432 is already bound on your machine (e.g. existing PostgreSQL), set HESBA_POSTGRES_PORT=5434
# and change the port in HESBA_DATABASE_URL and HESBA_DIRECT_URL accordingly.
HESBA_POSTGRES_PORT=5432
HESBA_DATABASE_URL=postgres://hesba_app:change-me-local@localhost:5432/hesba
HESBA_DIRECT_URL=postgres://hesba_migrator:change-me-local@localhost:5432/hesba
# Background job role (ADR-0024): only the catalog-promotion cron uses it. Never the migrator.
HESBA_SERVICE_DATABASE_URL=postgres://hesba_service:change-me-local@localhost:5432/hesba

# Auth & Security
HESBA_SESSION_SECRET=dummy-session-secret-change-in-local-and-prod-must-be-long
HESBA_CRON_SECRET=dummy-cron-secret-change-in-local-and-prod
HESBA_APP_ORIGIN=http://localhost:3000

# Integrations (optional / phase specific)
HESBA_LLM_PROVIDER=mock
HESBA_LLM_KEY=dummy-llm-key
HESBA_SENTRY_DSN=

# Transactional Email (Resend)
# Required in production/staging for account recovery and email verification.
# Server-only. Do NOT prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_placeholder_api_key
RESEND_FROM_EMAIL=Hesba <auth@hesba.app>

# Manual Subscription Renewal (public contact details shown to customers)
HESBA_RENEWAL_VODAFONE_CASH=01000000000
HESBA_RENEWAL_INSTAPAY=hesba@instapay
HESBA_RENEWAL_WHATSAPP=201000000000

# AI (ADR-0030). Server-only. No key = scanner on the local mock, assistant in private mode.
# The scanner sends photos only (no shop data). Recommended: Gemini free tier, approved by the owner.
HESBA_AI_SCANNER_PROVIDER=gemini
HESBA_AI_SCANNER_MODEL=gemini-3.5-flash-lite
HESBA_AI_SCANNER_API_KEY=
# The assistant. Shop data (sales, debts, customer names) is sent to the model ONLY when
# HESBA_AI_ASSISTANT_DATA_SHARING=approved — set it only for a provider tier whose terms do not
# use the data for training or human review (e.g. Gemini Paid). Otherwise: private mode.
HESBA_AI_ASSISTANT_PROVIDER=gemini
HESBA_AI_ASSISTANT_MODEL=gemini-3.6-flash
HESBA_AI_ASSISTANT_API_KEY=
HESBA_AI_ASSISTANT_DATA_SHARING=none
# Legacy name, still read as a fallback for both keys: GEMINI_API_KEY
# Limits, quotas and the budget are set in /admin (database), not here.
