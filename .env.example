# Database & Local Development Ports
# Local Postgres container host port (defaults to 5432 in docker-compose.dev.yml).
# If port 5432 is already bound on your machine (e.g. existing PostgreSQL), set HESBA_POSTGRES_PORT=5434
# and change the port in HESBA_DATABASE_URL and HESBA_DIRECT_URL accordingly.
HESBA_POSTGRES_PORT=5432
HESBA_DATABASE_URL=postgres://hesba_app:change-me-local@localhost:5432/hesba
HESBA_DIRECT_URL=postgres://hesba_migrator:change-me-local@localhost:5432/hesba

# Auth & Security
HESBA_SESSION_SECRET=dummy-session-secret-change-in-local-and-prod-must-be-long
HESBA_CRON_SECRET=dummy-cron-secret-change-in-local-and-prod
HESBA_APP_ORIGIN=http://localhost:3000

# Integrations (optional / phase specific)
HESBA_SMS_PROVIDER=mock
HESBA_SMS_KEY=dummy-sms-key
HESBA_LLM_PROVIDER=mock
HESBA_LLM_KEY=dummy-llm-key
HESBA_SENTRY_DSN=

# Manual Subscription Renewal (public contact details shown to customers)
HESBA_RENEWAL_VODAFONE_CASH=01000000000
HESBA_RENEWAL_INSTAPAY=hesba@instapay
HESBA_RENEWAL_WHATSAPP=201000000000
